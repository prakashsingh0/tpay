{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": ["./*"],
      "@store/*": ["app/redux/*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ],
  "plugins": [
    [
      "module-resolver",
      {
        "alias": {
          "@store": "./app/redux"
        }
      }
    ]
  ]
}
